---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Projects from "../components/Projects.astro";
import ChatBox from "../components/ChatBox.tsx";
---

<Layout>
  <Navbar />

  <main class="max-w-5xl mx-auto px-6">
    <Hero />
    <Services />
    <Projects />
    <section id="contact" class="py-16 border-t border-zinc-800/80">
      <h2 class="text-2xl md:text-3xl font-bold text-white">
        Cotizá tu proyecto con mi Asistente IA
      </h2>
      <p class="mt-2 text-zinc-400 max-w-xl">
        Contale qué necesitás. En menos de 2 minutos analiza tu idea y me envía
        el resumen para que te responda con una propuesta.
      </p>

      <div class="mt-8 p-8 rounded-xl bg-zinc-900/60 border border-zinc-800 text-center text-zinc-500">
        <ChatBox client:load />
      </div>
    </section>
  </main>

  <footer class="border-t border-zinc-800 mt-16 py-8 text-center text-sm text-zinc-500">
    © {new Date().getFullYear()} Fernando Sánchez — Desarrollo Web &
    Automatización con IA.
  </footer>
</Layout>
