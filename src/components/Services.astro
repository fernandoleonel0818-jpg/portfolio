---
const services = [
  {
    number: "01",
    title: "Desarrollo Web Moderno",
    description:
      "Landing pages, tiendas online y aplicaciones web optimizadas para cargar rápido, verse bien en celulares y convertir visitas en clientes.",
  },
  {
    number: "02",
    title: "Asistentes con IA",
    description:
      "Integración de chatbots inteligentes entrenados con la información de tu negocio para responder dudas y calificar prospectos en tiempo real.",
  },
  {
    number: "03",
    title: "Automatización de Datos",
    description:
      "Conexión entre tu web, APIs de IA, bases de datos y correo electrónico para que recibas cada lead estructurado y listo para cerrar.",
  },
];
---

<section id="about" class="py-20 border-t border-zinc-800/80">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <span class="text-xs font-semibold uppercase tracking-widest text-emerald-400">
        Servicios
      </span>
      <h2 class="mt-2 text-2xl md:text-3xl font-bold text-white">
        Qué puedo construir para vos
      </h2>
    </div>
    <p class="text-sm text-zinc-400 max-w-md">
      Soluciones prácticas pensadas para ahorrar tiempo operativo y mejorar la
      captación de clientes.
    </p>
  </div>

  <div class="mt-12 grid md:grid-cols-3 gap-6">
    {services.map((service) => (
      <article class="group p-6 rounded-2xl bg-zinc-900/40 border border-zinc-800/80 hover:border-emerald-500/40 hover:bg-zinc-900/80 transition-all duration-300 hover:-translate-y-1">
        <span class="inline-block text-xs font-mono text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-md border border-emerald-500/20">
          {service.number}
        </span>
        <h3 class="mt-5 text-lg font-semibold text-white group-hover:text-emerald-300 transition-colors">
          {service.title}
        </h3>
        <p class="mt-3 text-sm text-zinc-400 leading-relaxed">
          {service.description}
        </p>
      </article>
    ))}
  </div>
</section>
