---
const projects = [
  {
    title: "Asistente Calificador de Leads con IA",
    description:
      "Chat conversacional integrado en web que detecta necesidades del cliente, clasifica la prioridad y dispara un resumen automático por email.",
    tags: ["Astro", "React", "TypeScript", "Gemini API"],
  },
  {
    title: "Tienda Online Autogestionable",
    description:
      "E-commerce completo con catálogo administrable, carrito de compras, pasarela de pagos y notificaciones automáticas por correo.",
    tags: ["Astro", "Tailwind CSS", "Firebase", "Pagos"],
  },
  {
    title: "Sistema de Gestión de Reservas",
    description:
      "Aplicación para administrar turnos y disponibilidad en tiempo real con base de datos en la nube y panel simplificado.",
    tags: ["Mobile", "Firebase", "Base de Datos"],
  },
];
---

<section id="projects" class="py-20 border-t border-zinc-800/80">
  <span class="text-xs font-semibold uppercase tracking-widest text-emerald-400">
    Portafolio
  </span>
  <h2 class="mt-2 text-2xl md:text-3xl font-bold text-white">
    Proyectos destacados
  </h2>
  <p class="mt-2 text-zinc-400 max-w-xl">
    Desarrollos reales que combinan interfaces limpias, lógica sólida y
    automatización.
  </p>

  <div class="mt-12 grid md:grid-cols-3 gap-6">
    {projects.map((project) => (
      <article class="group p-6 rounded-2xl bg-gradient-to-b from-zinc-900/70 to-zinc-900/30 border border-zinc-800/80 hover:border-emerald-500/40 transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-white group-hover:text-emerald-300 transition-colors">
              {project.title}
            </h3>
          </div>
          <p class="mt-3 text-sm text-zinc-400 leading-relaxed">
            {project.description}
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-zinc-800/60 flex flex-wrap gap-2">
          {project.tags.map((tag) => (
            <span class="px-2.5 py-1 text-xs font-medium rounded-md bg-zinc-800/80 text-zinc-300 border border-zinc-700/50">
              {tag}
            </span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
