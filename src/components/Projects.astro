---
import { projects } from "../data/projects";
---

<section id="projects" class="py-20">
  <div class="mb-10">
    <h2 class="text-3xl font-bold text-white tracking-tight">
      Proyectos destacados
    </h2>
    <p class="mt-2 text-zinc-400">
      Algunos de los sistemas, sitios web y automatizaciones que desarrollé.
    </p>
  </div>

  <!-- Cambiá a lg:grid-cols-3 cuando tengas 3 o más proyectos -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {projects.map((project) => (
      <article class="group rounded-2xl bg-zinc-900/60 border border-zinc-800 overflow-hidden flex flex-col hover:border-emerald-500/40 transition-colors">
        {/* Contenedor de imagen en formato 16:9 */}
        <div class="aspect-video w-full overflow-hidden bg-zinc-950 border-b border-zinc-800">
          <img
            src={project.image}
            alt={`Vista previa de ${project.title}`}
            loading="lazy"
            class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300"
          />
        </div>

        {/* Info del proyecto */}
        <div class="p-6 flex flex-col flex-1">
          <h3 class="text-xl font-semibold text-white">{project.title}</h3>
          <p class="mt-2 text-sm text-zinc-400 leading-relaxed flex-1">
            {project.description}
          </p>

          {/* Etiquetas de tecnologías */}
          <div class="mt-4 flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="text-xs font-medium px-2.5 py-1 rounded-md bg-zinc-800/80 text-zinc-300 border border-zinc-700/50">
                {tag}
              </span>
            ))}
          </div>

          {/* Botones (solo aparecen si cargaste los links) */}
          {(project.demoUrl || project.repoUrl) && (
            <div class="mt-6 pt-4 border-t border-zinc-800/80 flex items-center gap-4 text-sm font-medium">
              {project.demoUrl && (
                <a
                  href={project.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-emerald-400 hover:text-emerald-300 transition-colors"
                >
                  Ver demo en vivo →
                </a>
              )}
              {project.repoUrl && (
                <a
                  href={project.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-zinc-400 hover:text-white transition-colors"
                >
                  Código
                </a>
              )}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
